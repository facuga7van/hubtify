{
  "name": "hubtify",
  "productName": "Hubtify",
  "version": "0.9.4",
  "description": "Gamified life hub — quests, nutrition, and finance in one RPG app",
  "main": ".vite/build/main.js",
  "private": true,
  "publish": {
    "provider": "github",
    "owner": "facuga7van",
    "repo": "hubtify"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --project unit",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs --project unit",
    "test:visual": "vitest run --project browser",
    "test:visual:watch": "vitest --project browser",
    "test:visual:mobile": "vitest run --project browser-mobile",
    "test:e2e": "playwright test",
    "typecheck:shared-logic": "tsc -p shared-logic --noEmit",
    "ai:bench": "node --experimental-strip-types scripts/ai-benchmark.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "mobile:build": "vite build -c vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && node scripts/android-version.mjs && cap sync android",
    "mobile:run": "npm run mobile:sync && cap run android",
    "mobile:apk": "npm run mobile:sync && node scripts/gradle.mjs assembleDebug",
    "mobile:apk:release": "npm run mobile:sync && node scripts/gradle.mjs assembleRelease"
  },
  "author": {
    "name": "facuga7van"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/howler": "^2.2.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "cross-env": "^10.1.0",
    "electron": "41.0.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.7.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.0",
    "vitest-browser-react": "^2.2.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "firebase": "^12.11.0",
    "gsap": "^3.14.2",
    "howler": "^2.2.4",
    "i18next": "^25.10.2",
    "page-flip": "^2.0.7",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pixi.js": "^8.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.6.0",
    "react-router-dom": "^7.13.1"
  }
}
